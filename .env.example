# ────────────────────────────────────────────────────────────────────────
# Shared (cả LOCAL mode và CI mode đều cần)
# ────────────────────────────────────────────────────────────────────────

# Claude Agent SDK
# Dùng Anthropic chính thống:
ANTHROPIC_AUTH_TOKEN=your_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
MODEL=claude-sonnet-4-20250514

# Hoặc DeepSeek-style compat:
# ANTHROPIC_AUTH_TOKEN=your_deepseek_key
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL=deepseek-v4-flash

# ────────────────────────────────────────────────────────────────────────
# LOCAL mode only (telegram_bot.py + raw-watcher.sh + sync-and-rebuild.sh)
# Bỏ qua nếu chỉ dùng cloud mode (GitHub Actions + Cloudflare Worker).
# ────────────────────────────────────────────────────────────────────────

# Telegram bot long-poll (telegram_bot.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
QUARTZ_PUBLIC_BASE_URL=https://your-site.pages.dev

# Cloudflare Pages auto-deploy (sync-and-rebuild.sh)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=

# ────────────────────────────────────────────────────────────────────────
# CLOUD mode (GitHub Actions + Cloudflare Worker)
# ⚠️ KHÔNG đặt các giá trị này trong .env — set ở:
#   • GitHub repo Settings → Secrets and variables → Actions
#   • cloudflare-worker/: `wrangler secret put <NAME>`
# Liệt kê ở đây chỉ để document.
#
# GitHub Actions secrets cần set:
#   ANTHROPIC_AUTH_TOKEN, ANTHROPIC_BASE_URL, MODEL
#   TELEGRAM_BOT_TOKEN
#   QUARTZ_PUBLIC_BASE_URL
#   CLOUDFLARE_PAGES_PROJECT (optional, fallback cho compute URL)
#
# Cloudflare Worker secrets cần set (qua wrangler):
#   TELEGRAM_BOT_TOKEN
#   ALLOWED_CHAT_ID         (cùng giá trị TELEGRAM_ALLOWED_CHAT_ID)
#   WEBHOOK_SECRET          (random 32+ ký tự, share với Telegram setWebhook)
#   GITHUB_DISPATCH_TOKEN   (PAT scope `repo`)
#   GITHUB_REPO             (vd "liangdabiao/llm-wiki")
#
# Xem cloudflare-worker/README.md cho setup chi tiết.
# ────────────────────────────────────────────────────────────────────────
